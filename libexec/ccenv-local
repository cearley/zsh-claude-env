#!/usr/bin/env bash
# Summary: Get or set the local (per-directory) profile
#
# Usage: ccenv local
#        ccenv local <name>
#        ccenv local --unset
#
# `ccenv local <name>` writes <name> to a `.claude-profile` file in the
# current directory only (never an ancestor), but only if <name> is a
# registered profile — otherwise this errors to stderr, exits non-zero,
# and writes nothing.
#
# With no argument, prints the local tier's resolved value: the content
# of the first `.claude-profile` found by searching $PWD and then each
# parent directory in turn, or a message indicating none was found.
# `ccenv local --unset` removes `.claude-profile` from the current
# directory only, leaving any ancestor's file untouched.
#
# A SET or --unset here only has any visible effect once shell
# integration (`eval "$(ccenv init -)"`) is active -- that's what keeps
# CLAUDE_CONFIG_DIR exported to match. If CCENV_LOADED (the marker
# ccenv-init exports) is absent, this still performs the write and exits
# 0 -- it's a warning, not an error, since the file itself is written
# regardless of whether anything is watching it -- but warns on stderr
# first. The no-argument GET path never warns.

set -e
[ -n "$CCENV_DEBUG" ] && set -x

bin_path="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=ccenv--resolve.sh
source "$bin_path/ccenv--resolve.sh"

name="$1"

if [ -z "$name" ]; then
  if _ccenv_local_lookup && [ -n "$REPLY" ]; then
    echo "$REPLY"
    exit 0
  fi
  echo "ccenv: no local profile set" >&2
  exit 1
fi

if [ -z "$CCENV_LOADED" ]; then
  echo 'ccenv: warning: shell integration not active — run eval "$(ccenv init -)" first' >&2
fi

if [ "$name" = "--unset" ]; then
  rm -f "$PWD/.claude-profile"
  exit 0
fi

if ! _ccenv_valid_name "$name"; then
  echo "ccenv: '${name}' is not a valid profile name" >&2
  exit 1
fi

if ! _ccenv_is_registered "$name"; then
  echo "ccenv: \`$name' is not a registered profile" >&2
  exit 1
fi

printf '%s\n' "$name" > "$PWD/.claude-profile"
